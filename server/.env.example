PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/quickbiz
JWT_SECRET=
CORS_ORIGIN=

# NOTE: Google Cloud Vision has been removed.
# OCR is now performed on-device using Google ML Kit Text Recognition v2 (expo-mlkit-ocr).
# No service-account JSON key or GOOGLE_APPLICATION_CREDENTIALS is required.